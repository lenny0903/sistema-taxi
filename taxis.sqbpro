ue="210"/><column index="4" value="69"/><column index="5" value="91"/><column index="6" value="54"/><column index="7" value="62"/><column index="8" value="121"/><column index="9" value="210"/><column index="10" value="210"/><column index="11" value="171"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE despachos (
    id_despacho INTEGER PRIMARY KEY AUTOINCREMENT,
    origen_despacho TEXT NOT NULL,
    fecha_hora_embarque DATETIME,
    cliente_id INTEGER NOT NULL,
    conductor_id INTEGER NOT NULL,
    auto_id INTEGER NOT NULL,
    tarifa REAL NOT NULL,
    estado_despacho TEXT NOT NULL DEFAULT 'pendiente',
    fecha_hora_inicio DATETIME NOT NULL,
    fecha_hora_fin DATETIME,
    grupo_id TEXT,
    FOREIGN KEY(cliente_id) REFERENCES clientes(id_cliente),
    FOREIGN KEY(conductor_id) REFERENCES conductores(id_conductor),
    FOREIGN KEY(auto_id) REFERENCES autos(id_auto),
    FOREIGN KEY(grupo_id) REFERENCES grupos(grupo_id)
);



</sql><current_tab id="0"/></tab_sql></sqlb_project>
